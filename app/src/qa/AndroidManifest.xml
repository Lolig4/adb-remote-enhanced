<?xml version="1.0" encoding="utf-8"?>
<!-- QA build only: in-process debug bridge for crash sweeps. Not part of the reconstruction. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- own authorities so the original app can stay installed next to this build -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.provider" tools:replace="android:authorities" />
        <provider android:name=".provider.AppProvider" android:authorities="${applicationId}.providers.app_provider" tools:replace="android:authorities" />
        <provider android:name=".provider.FileProvider" android:authorities="${applicationId}.providers.file_provider" tools:replace="android:authorities" />
        <!-- installs the crash recorder + activity tracker at process start -->
        <provider
            android:name=".qa.DebugInit"
            android:authorities="${applicationId}.qa_init"
            android:exported="false" />
        <!-- only the shell (holds DUMP) can drive it: adb shell am broadcast -->
        <receiver
            android:name=".qa.DebugBridge"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
